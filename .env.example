# ─────────────────────────────────────────────────────────────────────────────
# AI Business Knowledge Assistant — configuration
# Copy to `.env` and fill in. Everything has a sensible default; the only thing
# you need for LIVE Claude answers is ANTHROPIC_API_KEY. Without it, the demo
# still runs in OFFLINE mode using the deterministic cached answers for the
# scripted questions (see docs/demo-script.md).
# ─────────────────────────────────────────────────────────────────────────────

# --- LLM (Anthropic Claude) ---------------------------------------------------
ANTHROPIC_API_KEY=
# Model routing: high-quality generation on Opus, fast routing/SQL on Sonnet.
ABA_MODEL_GENERATION=claude-opus-4-8
ABA_MODEL_ROUTER=claude-sonnet-4-6
ABA_MODEL_SQL=claude-sonnet-4-6

# Offline demo mode: "auto" (use cache when no key / on error), "always", "never".
ABA_OFFLINE_MODE=auto

# --- Embeddings (local, multilingual) ----------------------------------------
# Used when sentence-transformers + the model are installed (Docker image).
# Falls back to a deterministic hashing embedding otherwise, so the app always runs.
ABA_EMBEDDING_MODEL=BAAI/bge-m3
ABA_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ABA_ENABLE_RERANK=true

# --- Vector store -------------------------------------------------------------
# "numpy" (in-process, zero-dependency, default) or "qdrant" (docker-compose service).
ABA_VECTOR_BACKEND=numpy
ABA_QDRANT_URL=http://qdrant:6333

# --- Retrieval tuning ---------------------------------------------------------
ABA_DENSE_TOP_K=20
ABA_BM25_TOP_K=20
ABA_RRF_K=60
ABA_FINAL_K=5
ABA_RERANK_TOP_N=20
ABA_MIN_EVIDENCE_SCORE=0.02

# --- SQL safety ---------------------------------------------------------------
ABA_SQL_ROW_LIMIT=200
ABA_SQL_TIMEOUT_SECONDS=5

# --- Paths --------------------------------------------------------------------
ABA_DATA_DIR=data
